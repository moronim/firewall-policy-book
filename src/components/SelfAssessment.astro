---
// Interactive version of the Chapter 15 self-assessment. Statements, scale and
// stage bands come from src/data/assessment.json (generated by npm run sync);
// stage names and next steps are from Chapter 6.
import assessment from '../data/assessment.json';

const { min, max, sections, stages } = assessment;
const points = Array.from({ length: max - min + 1 }, (_, i) => min + i);
const total = sections.reduce((n, s) => n + s.items.length * max, 0);

const stageInfo = {
	1: {
		name: 'Reactive/Chaos',
		next: 'The first step out is rarely a tool. It is writing the policy down and putting every change through a ticket, however simple the workflow.',
	},
	2: {
		name: 'Emerging',
		next: 'The usual next step is connecting the pieces: one record of rules and owners that matches the running configuration, and analysis that runs on a schedule rather than whenever someone has time.',
	},
	3: {
		name: 'Mature',
		next: 'The move toward Stage Four is tying rules to the applications and services they serve, so that changes are judged for business impact as well as technical risk.',
	},
	4: {
		name: 'Highly Mature/Adaptive',
		next: 'The danger at this stage is trusting the machinery too far. The rules that drive the automation, such as approval thresholds and self-service boundaries, drift like any other rulebase and need recertification on the same terms.',
	},
};
---

<div class="sa not-content" data-stages={JSON.stringify(stages)} data-stage-info={JSON.stringify(stageInfo)} data-total={total}>
	<form class="sa-form" novalidate>
		{
			sections.map((section, s) => (
				<section class="sa-section" data-section={s} data-title={section.title} data-max={section.items.length * max}>
					<h2>{section.title}</h2>
					{section.items.map((item, i) => (
						<fieldset class="sa-item">
							<legend>{item}</legend>
							<div class="sa-scale">
								{points.map((p) => (
									<label>
										<input type="radio" name={`q-${s}-${i}`} value={p} />
										<span>{p}</span>
									</label>
								))}
							</div>
						</fieldset>
					))}
					<p class="sa-subtotal">
						Subtotal: <strong data-subtotal>0</strong> / {section.items.length * max}
					</p>
				</section>
			))
		}
	</form>

	<aside class="sa-result" aria-live="polite">
		<h2>Your result</h2>
		<p class="sa-progress" data-progress></p>
		<p class="sa-total">
			<span data-total-score>0</span> <span class="sa-of">/ {total}</span>
		</p>
		<p class="sa-stage" data-stage></p>
		<div class="sa-bars">
			{
				sections.map((section, s) => (
					<div class="sa-bar" data-bar={s}>
						<div class="sa-bar-label">
							<span>{section.title}</span>
							<span data-bar-value>0 / {section.items.length * max}</span>
						</div>
						<div class="sa-bar-track">
							<div class="sa-bar-fill" />
						</div>
					</div>
				))
			}
		</div>
		<p class="sa-weakest" data-weakest></p>
		<p class="sa-next" data-next></p>
		<button type="button" class="sa-reset" data-reset>Clear my answers</button>
	</aside>
</div>

<script>
	const KEY = 'fpm-self-assessment-v1';

	for (const root of document.querySelectorAll<HTMLElement>('.sa')) {
		const form = root.querySelector('form')!;
		const stages: { min: number; max: number; stage: number }[] = JSON.parse(root.dataset.stages!);
		const stageInfo: Record<number, { name: string; next: string }> = JSON.parse(root.dataset.stageInfo!);
		const total = Number(root.dataset.total);
		const sections = [...root.querySelectorAll<HTMLElement>('.sa-section')];
		const questions = sections.flatMap((s) => [...s.querySelectorAll('fieldset')]).length;

		// Answers stay in this browser only; storage can be unavailable, so every access is guarded.
		const load = () => {
			try {
				return JSON.parse(localStorage.getItem(KEY) ?? '{}');
			} catch {
				return {};
			}
		};
		const save = (answers: Record<string, string>) => {
			try {
				localStorage.setItem(KEY, JSON.stringify(answers));
			} catch {}
		};

		for (const [name, value] of Object.entries(load())) {
			const input = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`);
			if (input) input.checked = true;
		}

		const render = () => {
			const data = new FormData(form);
			const answers = Object.fromEntries([...data.entries()].map(([k, v]) => [k, String(v)]));
			save(answers);
			const answered = Object.keys(answers).length;

			const scores = sections.map((section) => {
				let sum = 0;
				for (const input of section.querySelectorAll<HTMLInputElement>('input:checked')) sum += Number(input.value);
				const max = Number(section.dataset.max);
				section.querySelector('[data-subtotal]')!.textContent = String(sum);
				return { title: section.dataset.title!, sum, max };
			});
			const score = scores.reduce((n, s) => n + s.sum, 0);

			root.querySelector('[data-total-score]')!.textContent = String(score);
			scores.forEach((s, i) => {
				const bar = root.querySelector<HTMLElement>(`[data-bar="${i}"]`)!;
				bar.querySelector('[data-bar-value]')!.textContent = `${s.sum} / ${s.max}`;
				bar.querySelector<HTMLElement>('.sa-bar-fill')!.style.width = `${(s.sum / s.max) * 100}%`;
			});

			const progress = root.querySelector('[data-progress]')!;
			const stageEl = root.querySelector('[data-stage]')!;
			const weakest = root.querySelector('[data-weakest]')!;
			const next = root.querySelector('[data-next]')!;

			if (answered < questions) {
				progress.textContent = `${answered} of ${questions} statements scored. Score them all to see your stage.`;
				stageEl.textContent = '';
				weakest.textContent = '';
				next.textContent = '';
				root.classList.remove('sa-done');
				return;
			}

			root.classList.add('sa-done');
			progress.textContent = `All ${questions} statements scored.`;
			const band = stages.find((b) => score >= b.min && score <= b.max)!;
			const info = stageInfo[band.stage];
			stageEl.textContent = `Stage ${band.stage}: ${info.name} (${band.min}–${band.max} of ${total})`;

			const low = Math.min(...scores.map((s) => s.sum / s.max));
			const lowest = scores.filter((s) => s.sum / s.max === low).map((s) => s.title);
			weakest.textContent =
				lowest.length === scores.length
					? 'Your three sections score evenly, so no single section is dragging the total down.'
					: `${lowest.join(' and ')} ${lowest.length > 1 ? 'pull' : 'pulls'} your total down most. That is where the next quarter's work goes.`;
			next.textContent = info.next;
		};

		form.addEventListener('change', render);
		root.querySelector('[data-reset]')!.addEventListener('click', () => {
			form.reset();
			render();
		});
		render();
	}
</script>

<style>
	.sa {
		display: grid;
		gap: 2rem;
	}
	@media (min-width: 72rem) {
		.sa {
			grid-template-columns: minmax(0, 1fr) 18rem;
			align-items: start;
		}
		.sa-result {
			position: sticky;
			top: calc(var(--sl-nav-height) + 1.5rem);
		}
	}
	.sa-section + .sa-section {
		margin-top: 2.5rem;
	}
	.sa-section h2 {
		font-size: var(--sl-text-h3);
		font-weight: 600;
		color: var(--sl-color-white);
		line-height: var(--sl-line-height-headings);
	}
	.sa-item {
		border: 0;
		padding: 0;
		margin: 1rem 0 0;
	}
	.sa-item legend {
		padding: 0;
		margin-bottom: 0.5rem;
		color: var(--sl-color-white);
	}
	.sa-scale {
		display: flex;
		gap: 0.375rem;
		flex-wrap: wrap;
	}
	.sa-scale label {
		position: relative;
	}
	.sa-scale input {
		position: absolute;
		opacity: 0;
		inset: 0;
		margin: 0;
		cursor: pointer;
	}
	.sa-scale span {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		font-variant-numeric: tabular-nums;
	}
	.sa-scale input:checked + span {
		background: var(--sl-color-accent);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-black);
		font-weight: 600;
	}
	.sa-scale input:focus-visible + span {
		outline: 2px solid var(--sl-color-accent-high);
		outline-offset: 2px;
	}
	.sa-subtotal {
		margin-top: 1rem;
		color: var(--sl-color-gray-2);
	}
	.sa-result {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 1.25rem;
		background: var(--sl-color-gray-6);
	}
	.sa-result h2 {
		margin: 0;
		font-size: var(--sl-text-h4);
	}
	.sa-result > * + * {
		margin-top: 0.75rem;
	}
	.sa-progress {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.sa-total {
		font-size: 2.5rem;
		font-weight: 600;
		line-height: 1;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.sa-of {
		font-size: 1rem;
		font-weight: 400;
		color: var(--sl-color-gray-3);
	}
	.sa-stage {
		font-weight: 600;
		color: var(--sl-color-accent-high);
	}
	.sa-stage:empty,
	.sa-weakest:empty,
	.sa-next:empty {
		display: none;
	}
	.sa-bar-label {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		font-size: var(--sl-text-sm);
	}
	.sa-bar-track {
		height: 0.5rem;
		border-radius: 999px;
		background: var(--sl-color-gray-5);
		overflow: hidden;
		margin-top: 0.25rem;
	}
	.sa-bar-fill {
		height: 100%;
		width: 0;
		background: var(--sl-color-accent);
		transition: width 0.2s;
	}
	.sa-bar + .sa-bar {
		margin-top: 0.5rem;
	}
	.sa-weakest,
	.sa-next {
		font-size: var(--sl-text-sm);
	}
	.sa-reset {
		font: inherit;
		font-size: var(--sl-text-sm);
		background: none;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.375rem;
		padding: 0.25rem 0.75rem;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
</style>
